{
  "name": "credit-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Credit limit monitoring and exposure analysis demo for Bluspring Enterprises",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "CREDIT_GUARD_DEV_DEFAULT_USER=administrator LLM_PROVIDER=gemini LLM_MODEL=gemini-3.1-flash-lite LLM_TIMEOUT_MS=25000 AGENT_MEMORY_ENABLED=true cds-serve --port 3000",
    "start": "CREDIT_GUARD_DEV_DEFAULT_USER=administrator LLM_PROVIDER=gemini LLM_MODEL=gemini-3.1-flash-lite LLM_TIMEOUT_MS=25000 AGENT_MEMORY_ENABLED=true cds-serve --port 3000",
    "start:cf": "cds-serve",
    "start:persistent": "cds-serve --profile persistent",
    "build": "npm run build:cf",
    "lint": "node --check srv/server.js",
    "test": "node --test tests/*.test.js",
    "build:cf": "cds build --production --opts contentHdbtabledata=true && node -e \"const fs=require('fs');fs.mkdirSync('gen/srv/app',{recursive:true});fs.cpSync('app/credit','gen/srv/app/credit',{recursive:true})\""
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "database": ":memory:"
          }
        },
        "[persistent!]": {
          "kind": "sqlite",
          "credentials": {
            "database": "credit-guard.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "login_required": true,
          "users": {
            "reader": {
              "roles": [
                "CreditReader"
              ]
            },
            "requester": {
              "roles": [
                "CreditReader",
                "CreditRequester"
              ]
            },
            "controller": {
              "roles": [
                "CreditReader",
                "CreditRequester",
                "CreditController"
              ]
            },
            "finance": {
              "roles": [
                "CreditReader",
                "CreditRequester",
                "FinanceHead"
              ]
            },
            "analyst": {
              "roles": [
                "CreditReader",
                "CreditRequester",
                "CreditAnalyst"
              ]
            },
            "manager": {
              "roles": [
                "CreditReader",
                "CreditRequester",
                "CreditController",
                "CreditManager"
              ]
            },
            "approver": {
              "roles": [
                "CreditReader",
                "CreditRequester",
                "FinanceHead",
                "CreditApprover"
              ]
            },
            "administrator": {
              "roles": [
                "CreditReader",
                "CreditRequester",
                "CreditController",
                "FinanceHead",
                "CreditAdmin"
              ]
            },
            "monitor": {
              "roles": [
                "CreditReader",
                "CreditMonitor"
              ]
            },
            "jobScheduler": {
              "roles": [
                "CreditReader",
                "CreditMonitorJob"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa",
          "vcap": {
            "label": "xsuaa"
          }
        }
      }
    }
  },
  "dependencies": {
    "@cap-js/hana": "^1",
    "@cap-js/sqlite": "^1",
    "@google/genai": "^3.0.0",
    "@sap-cloud-sdk/connectivity": "~4.7.0",
    "@sap-cloud-sdk/http-client": "~4.7.0",
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "dotenv": "^16",
    "express": "^4",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8"
  },
  "overrides": {
    "@sap-cloud-sdk/resilience": "4.7.0"
  }
}
