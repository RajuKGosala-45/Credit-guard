AGENT_MEMORY_ENABLED=true
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
LLM_TIMEOUT_MS=25000

# SAP HANA Cloud Persistence (falls back to local SQLite when unset)
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=CREDIT_GUARD_HDI
HANA_ENCRYPT=true

# SAP S/4HANA & BTP Destination Connectivity (never hardcode secrets)
SAP_BTP_DESTINATION_NAME=
SAP_ODATA_BASE_URL=
SAP_CLIENT=100