{
  "welcomeFile": "/credit/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/"
  },
  "routes": [
    {
      "source": "^/health/(.*)$",
      "target": "/health/$1",
      "destination": "credit-guard-srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "destination": "credit-guard-srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}
